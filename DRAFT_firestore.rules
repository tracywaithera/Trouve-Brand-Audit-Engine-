rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'tier', 'createdAt', 'updatedAt']) 
        && data.keys().size() <= 10
        && data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 256
        && data.tier in ['free', 'pro']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Audit Validation ---
    function isValidAudit(data) {
      return data.keys().hasAll(['userId', 'userData', 'auditData', 'timestamp'])
        && data.keys().size() <= 6
        && data.userId == request.auth.uid
        && data.timestamp is timestamp
        && data.userData is map
        && data.auditData is map;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUser(incoming()) 
        && (
          // Action: Upgrade Tier
          (incoming().diff(existing()).affectedKeys().hasOnly(['tier', 'updatedAt']))
          ||
          // Action: Profile Update
          (incoming().diff(existing()).affectedKeys().hasAll(['updatedAt']) && !incoming().diff(existing()).affectedKeys().hasAny(['uid', 'email', 'createdAt']))
        )
        && incoming().updatedAt == request.time;
    }

    match /audits/{auditId} {
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidAudit(incoming()) && incoming().timestamp == request.time;
      allow delete: if isOwner(existing().userId);
    }
  }
}
